                "GLM_FORCE_DEPTH_ZERO_TO_ONE"
            ],
            "compilerPath": "${env:MSVC}",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}