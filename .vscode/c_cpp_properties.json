{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/build/vcpkg_installed/x64-windows/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
